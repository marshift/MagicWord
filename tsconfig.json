{
	"include": ["./src/**/*"],
	"compilerOptions": {
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,

		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,

		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"noEmit": true
	}
}
